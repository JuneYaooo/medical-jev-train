{
  "model": {
    "model_path": "../../models/Qwen3.5-4B",
    "device": "cuda",
    "dtype": "bf16",
    "attn_implementation": "sdpa",
    "max_tokens": 1536,
    "max_options": 26,
    "gradient_checkpointing": true,
    "pass_position_ids": true,
    "lora": {"layers": "all", "rank": 16, "alpha": 32, "dropout": 0.05, "targets": null}
  },
  "data": {
    "train": [
      {"path": "../../work/splits/pool.jsonl", "max_rows": 30000, "seed": 17}
    ],
    "development": "../../work/splits/development.jsonl"
  },
  "objective": {"label_smoothing": 0.05, "hard_tasks": []},
  "optim": {"lr": 1e-4, "epochs": 2, "batch_size": 8, "grad_accum": 2, "warmup_ratio": 0.03,
            "scheduler": "cosine", "min_lr_ratio": 0.1, "weight_decay": 0.0, "clip": 1.0},
  "eval_every": 500,
  "eval_views": 1,
  "save_every": 200,
  "log_every": 20,
  "seed": 17
}
